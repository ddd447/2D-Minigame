<Window x:Class="_2D_Minigame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920" VerticalAlignment="Center" HorizontalAlignment="Center"
        Title="MainWindow" MinHeight="1200" MaxHeight="1200" Height="1200" MinWidth="2000" Width="2000" MaxWidth="2000">
    <Window.Resources>
        <Style x:Key="GameMenuButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="250"/>
            <Setter Property="Height" Value="75"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF2E2E2E"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border 
                        Background="{TemplateBinding Background}" 
                        CornerRadius="20" 
                        Padding="10" 
                        SnapsToDevicePixels="True">
                            <ContentPresenter 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF444444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF1E1E1E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--<Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>-->
    </Window.Resources>

    <Grid x:Name="MainGrid" MinHeight="1080" MinWidth="1920" Background="Beige">

        <!-- Hauptmenü -->


        <Grid x:Name="MenuGrid">
            <Grid.Background>
                <ImageBrush ImageSource="1920x1080 Menu Screen.png" Stretch="Fill" />
            </Grid.Background>
            <Button x:Name="SoundToggleButton"
        Width="50"
        Height="50"
        FontSize="28"
        Content="🔊"
        Background="Transparent"
        BorderThickness="0"
        Cursor="Hand"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Margin="1451,263,0,0"
        Click="SoundToggleButton_Click"/>



            <Button x:Name="ContinueButton"
        Content="Fortsetzen"
        Style="{StaticResource GameMenuButtonStyle}"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Margin="1451,323,0,0"
        Click="ContinueButton_Click"
        Visibility="Collapsed"/>


            <!-- Nur Platzhalter-Buttons -->
            <Button x:Name="StartButton" Style="{StaticResource GameMenuButtonStyle}"/>
            <Button x:Name="LoadButton" Style="{StaticResource GameMenuButtonStyle}"/>
            <Button x:Name="OptionsButton" Style="{StaticResource GameMenuButtonStyle}"/>
            <Button x:Name="QuitButton" Style="{StaticResource GameMenuButtonStyle}"/>
        </Grid>

